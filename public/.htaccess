# ───────────────────────────────────────────────────────────────
# Hébergement Apache (Network Solutions) — application React (SPA)
# Toutes les URL inconnues du serveur sont renvoyées vers index.html :
# React Router affiche alors la bonne page… ou la page 404 du site.
# ───────────────────────────────────────────────────────────────
Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Forcer HTTPS (le certificat SSL doit être actif sur l'hébergement).
  # La 2e condition évite une boucle derrière un proxy/CDN qui termine le SSL.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Fichiers et dossiers existants : servis tels quels
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Tout le reste → application React
  RewriteRule ^ index.html [L]
</IfModule>

# Secours si mod_rewrite est indisponible
ErrorDocument 404 /index.html

# Cache : fichiers versionnés longue durée, index.html jamais en cache
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|svg|png|jpe?g|webp|gif|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  # HSTS : le navigateur n'utilisera plus que HTTPS pendant 1 an
  Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS
</IfModule>

# Types MIME et compression
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType font/woff2 .woff2
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/manifest+json
</IfModule>
